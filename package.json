{
  "name": "sastreria",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "ANDROID_HOME=/home/developer/Android/Sdk ANDROID_SDK_ROOT=/home/developer/Android/Sdk PATH=$PATH:/home/developer/Android/Sdk/platform-tools:/home/developer/Android/Sdk/emulator expo start",
    "dev:android": "ANDROID_HOME=/home/developer/Android/Sdk ANDROID_SDK_ROOT=/home/developer/Android/Sdk PATH=$PATH:/home/developer/Android/Sdk/platform-tools:/home/developer/Android/Sdk/emulator expo start --android",
    "dev:web": "expo start --web",
    "emulator": "bash scripts/start-emulator.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "apk:bg": "bash scripts/build-apk-bg.sh start debug",
    "apk:bg:install": "bash scripts/build-apk-bg.sh start debug --install",
    "apk:bg:release": "bash scripts/build-apk-bg.sh start release",
    "apk:bg:release:install": "bash scripts/build-apk-bg.sh start release --install",
    "apk:bg:status": "bash scripts/build-apk-bg.sh status",
    "apk:bg:logs": "bash scripts/build-apk-bg.sh logs",
    "apk:bg:stop": "bash scripts/build-apk-bg.sh stop",
    "metro:usb": "adb reverse tcp:8081 tcp:8081 && npm run dev",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --passWithNoTests --watchAll=false --coverage",
    "lint": "expo lint",
    "validate": "npm run typecheck && npm run test:ci",
    "validate:full": "npm run typecheck && npm run lint && npm run test:ci",
    "commit": "bash scripts/smart-commit.sh",
    "branch": "bash scripts/smart-branch.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "react-native-gesture-handler/jestSetup"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-url-polyfill)"
    ],
    "moduleNameMapper": {
      "^react-native-url-polyfill/auto$": "<rootDir>/__mocks__/react-native-url-polyfill-auto.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/__tests__/factories/"
    ],
    "collectCoverageFrom": [
      "src/features/**/*.{ts,tsx}",
      "src/data/**/*.{ts,tsx}",
      "src/shared/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60,
        "functions": 56,
        "branches": 50
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.8.2",
    "@react-navigation/material-top-tabs": "^7.6.13",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@supabase/supabase-js": "^2.105.1",
    "expo": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.74.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^7.0.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
